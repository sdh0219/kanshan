# 知乎开放平台 API 配置
ZHIHU_API_BASE=https://developer.zhihu.com
ZHIHU_ACCESS_SECRET=your_access_secret_here

# 直答 Agent 配置（同一 base URL，同一 Access Secret）
AGENT_API_BASE=https://developer.zhihu.com
AGENT_MODEL=zhida-fast-1p5

# 知乎 OAuth（黑客松项目页自动生成的凭证；app_key 走平台 Secret，不写在这里）
ZHIHU_OAUTH_APP_ID=
OAUTH_REDIRECT_URI=https://kanshan-detective.pages.dev/api/auth/callback

# 仅 server-node.ts（Node/容器部署备用入口）读取以下变量
PORT=9000
